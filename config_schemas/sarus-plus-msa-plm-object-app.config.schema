{
  "title": "Сервис для работы с объектами PLM (sarus-plus-msa-plm-object-app) — конфигурация",
  "documentation": "https://docs.sarusplus.ru/saruslpus_plm/system-administration/system-config/config-files/sarus-plus-msa-plm-object-app",
  "properties": {
    "SP_SERVICE_USER": {
      "description": "",
      "default": ""
    },
    "SP_PLM_OBJECT_PORT": {
      "description": "Порт Сервиса для работы с объектами PLM",
      "default": 8081
    },
    "SPRING_PROFILES_ACTIVE": {
      "description": "Профиль работы приложения",
      "default": "rel"
    },
    "GUARDANT_SERVER_IP": {
      "description": "IP-адрес сервера лицензий Guardant",
      "default": "127.0.0.1"
    },
    "MSA_AUTH_URI": {
      "description": "URI-адрес Сервиса авторизации и аутентификации",
      "default": "http://localhost:8080"
    },
    "MSA_DICTIONARY_CACHE_URI": {
      "description": "URI-адрес Кэш-сервиса получения справочников",
      "default": "http://localhost:8082"
    },
    "MSA_FILE_STORAGE_URI": {
      "description": "URI-адрес Сервиса управления файлами",
      "default": "http://localhost:8085"
    },
    "MSA_RELATION_URI": {
      "description": "URI-адрес Сервиса для работы с отношениями",
      "default": "http://localhost:8090"
    },
    "SARUS_API_HOST": {
      "description": "URI-адрес API Техплатформы «САРУС»",
      "default": "http://127.0.0.1:35000/v1"
    }
  }
}
