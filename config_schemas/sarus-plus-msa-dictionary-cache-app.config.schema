{
  "title": "Кэш-сервис получения справочников (sarus-plus-msa-dictionary-cache-app) — конфигурация",
  "documentation": "https://docs.sarusplus.ru/saruslpus_plm/system-administration/system-config/config-files/sarus-plus-msa-dictionary-cache-app",
  "properties": {
    "SP_SERVICE_USER": {
      "description": "",
      "default": ""
    },
    "SP_EXT_DICTIONARY_PORT": {
      "description": "",
      "default": ""
    },
    "SPRING_PROFILES_ACTIVE": {
      "description": "Профиль работы приложения",
      "default": "rel"
    },
    "GUARDANT_SERVER_IP": {
      "description": "IP-адрес сервера лицензий Guardant",
      "default": "127.0.0.1"
    },
    "MSA_AUTH_HOST": {
      "description": "URI-адрес Сервиса авторизации и аутентификации",
      "default": "http://localhost:8080"
    },
    "SARUS_API_HOST": {
      "description": "URI-адрес API Техплатформы «САРУС»",
      "default": "http://127.0.0.1:35000/v1"
    },
    "SARUS_ADMIN_USER": {
      "description": "Пользователь «Администратор Техплатформы «САРУС»",
      "default": "Администратор"
    },
    "SARUS_ADMIN_PASS": {
      "description": "Хэш пароля пользователя «Администратор Техплатформы «САРУС»",
      "default": "d41d8cd98f00b204e9800998ecf8427e"
    },
    "SPRING_DATA_REDIS_HOST": {
      "description": "Хост Redis",
      "default": "localhost"
    },
    "SPRING_DATA_REDIS_PORT": {
      "description": "Порт Redis",
      "default": 6379
    },
    "REDIS_EXPIRE_TIME": {
      "description": "Время жизни хранения информации в Redis",
      "default": 86400
    }
  }
}
