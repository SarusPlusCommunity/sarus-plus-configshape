{
  "title": "Сервис для работы с извещениями об изменениях (sarus-plus-msa-change-management-app) — конфигурация",
  "documentation": "https://docs.sarusplus.ru/saruslpus_plm/system-administration/system-config/config-files/sarus-plus-msa-change-management-app",
  "properties": {
    "SP_SERVICE_USER": {
      "description": "",
      "default": ""
    },
    "SP_CHANGE_MANAGEMENT_PORT": {
      "description": "Порт Сервиса для работы с извещениями об изменениях",
      "default": 8089
    },
    "SPRING_PROFILES_ACTIVE": {
      "description": "Профиль работы приложения",
      "default": "rel"
    },
    "GUARDANT_SERVER_IP": {
      "description": "IP-адрес сервера лицензий Guardant",
      "default": "127.0.0.1"
    },
    "MSA_DICTIONARY_CACHE_URI": {
      "description": "URI-адрес Кэш-сервиса получения справочников",
      "default": "http://localhost:8082"
    },
    "MSA_STATUS_MANAGEMENT_URI": {
      "description": "URI-адрес Сервиса для работы с применяемостью объектов",
      "default": "http://localhost:8088"
    },
    "MSA_RELATION_URI": {
      "description": "URI-адрес Сервиса для работы с отношениями",
      "default": "http://localhost:8090"
    },
    "SARUS_API_HOST": {
      "description": "URI-адрес API Техплатформы «САРУС»",
      "default": "http://127.0.0.1:35000/v1"
    }
  }
}
