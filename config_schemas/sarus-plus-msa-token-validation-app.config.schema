{
  "title": "Сервис валидации токена сессии (sarus-plus-msa-token-validation-app) — конфигурация",
  "documentation": "https://docs.sarusplus.ru/saruslpus_plm/system-administration/system-config/config-files/sarus-plus-msa-token-validation-app",
  "properties": {
    "SP_SERVICE_USER": {
      "description": "",
      "default": ""
    },
    "SERVICE_PORT": {
      "description": "Порт работы приложения",
      "default": ":8190"
    },
    "GUARDANT_SERVER_IP": {
      "description": "IP-адрес сервера лицензий Guardant",
      "default": "127.0.0.1"
    },
    "REDIS_HOST": {
      "description": "Хост Redis",
      "default": "localhost"
    },
    "REDIS_PORT": {
      "description": "Порт Redis",
      "default": 6379
    },
    "REDIS_JWT_SECRET": {
      "description": "Секрет для JWT токена",
      "default": "sarus-plus-is-the-best-plm-in-the-whole-world!"
    }
  }
}
