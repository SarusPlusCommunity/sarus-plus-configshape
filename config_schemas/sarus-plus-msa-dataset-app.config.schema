{
  "title": "Сервис для работы с наборами данных (sarus-plus-msa-dataset-app) — конфигурация",
  "documentation": "https://docs.sarusplus.ru/saruslpus_plm/system-administration/system-config/config-files/sarus-plus-msa-dataset-app",
  "properties": {
    "SP_SERVICE_USER": {
      "description": "",
      "default": ""
    },
    "SP_DATASET_PORT": {
      "description": "Порт Сервиса для работы с наборами данных",
      "default": 8092
    },
    "SPRING_PROFILES_ACTIVE": {
      "description": "Профиль работы приложения",
      "default": "rel"
    },
    "GUARDANT_SERVER_IP": {
      "description": "IP-адрес сервера лицензий Guardant",
      "default": "127.0.0.1"
    },
    "MSA_DICTIONARY_CACHE_URI": {
      "description": "URI-адрес Кэш-сервиса получения справочников",
      "default": "http://localhost:8082"
    },
    "MSA_FILE_STORAGE_URI": {
      "description": "Адрес микросервиса msa-file-storage-app",
      "default": "http://localhost:8085"
    },
    "SARUS_API_HOST": {
      "description": "URI-адрес API Техплатформы «САРУС»",
      "default": "http://127.0.0.1:35000/v1"
    }
  }
}
