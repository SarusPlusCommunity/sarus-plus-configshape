{
  "title": "Сервис авторизации и аутентификации (sarus-plus-msa-auth-app) — конфигурация",
  "documentation": "https://docs.sarusplus.ru/saruslpus_plm/system-administration/system-config/config-files/sarus-plus-msa-auth-app",
  "properties": {
    "SP_SERVICE_USER": {
      "description": "",
      "default": ""
    },
    "SP_AUTH_PORT": {
      "description": "Порт Сервиса авторизации и аутентификации",
      "default": 8080
    },
    "SPRING_PROFILES_ACTIVE": {
      "description": "Профиль работы приложения",
      "default": "rel"
    },
    "MSA_DICTIONARY_CACHE_URI": {
      "description": "URI-адрес Кэш-сервиса получения справочников",
      "default": "http://localhost:8082"
    },
    "GUARDANT_SERVER_IP": {
      "description": "IP-адрес сервера лицензий Guardant",
      "default": "127.0.0.1"
    },
    "LICENSE_ADMIN_KEY": {
      "description": "Секретный ключ доступа к административным методам",
      "default": "very-secret-admin-key"
    },
    "SARUS_API_HOST": {
      "description": "URI-адрес API Техплатформы «САРУС»",
      "default": "http://127.0.0.1:35000/v1"
    },
    "SARUS_ADMIN_USER": {
      "description": "Пользователь «Администратор Техплатформы «САРУС»",
      "default": "Администратор"
    },
    "SARUS_ADMIN_PASS": {
      "description": "Хэш пароля пользователя «Администратор Техплатформы «САРУС»",
      "default": "d41d8cd98f00b204e9800998ecf8427e"
    },
    "SARUS_SYSTEM_USER": {
      "description": "Системный пользователь Техплатформы «САРУС»",
      "default": "$System"
    },
    "SARUS_SYSTEM_OS": {
      "description": "Тип операционной системы Техплатформы (win, linux)",
      "default": "linux"
    },
    "SPRING_DATA_REDIS_HOST": {
      "description": "IP хоста Redis",
      "default": "127.0.0.1"
    },
    "SPRING_DATA_REDIS_PORT": {
      "description": "Порт Redis",
      "default": 6379
    },
    "REDIS_JWT_SECRET": {
      "description": "Секрет для JWT токена",
      "default": "sarus-plus-is-the-best-plm-in-the-whole-world!"
    },
    "REDIS_JWT_EXPIRATION_TIME": {
      "description": "Константа, определяющая время жизни JWT токена",
      "default": 46800000
    }
  }
}
