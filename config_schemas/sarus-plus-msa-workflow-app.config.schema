{
  "title": "Сервис управления бизнес-процессами (sarus-plus-msa-workflow-app) — конфигурация",
  "documentation": "https://docs.sarusplus.ru/saruslpus_plm/system-administration/system-config/config-files/sarus-plus-msa-workflow-app",
  "properties": {
    "SP_SERVICE_USER": {
      "description": "",
      "default": ""
    },
    "SP_WORKFLOW_PORT": {
      "description": "Порт Сервиса управления бизнес процессами",
      "default": 8086
    },
    "GUARDANT_SERVER_IP": {
      "description": "IP-адрес сервера лицензий Guardant",
      "default": "127.0.0.1"
    },
    "MSA_AUTH_HOST": {
      "description": "URI-адрес Сервиса авторизации и аутентификации",
      "default": "http://localhost:8080"
    },
    "MSA_DICTIONARY_CACHE_URI": {
      "description": "URI-адрес Кэш-сервиса получения справочников",
      "default": "http://localhost:8082"
    },
    "SARUS_API_HOST": {
      "description": "URI-адрес API Техплатформы «САРУС»",
      "default": "http://127.0.0.1:35000/v1"
    },
    "SARUS_SYSTEM_PASS": {
      "description": "Хэш пароля системного пользователя Техплатформы «САРУС»",
      "default": "d41d8cd98f00b204e9800998ecf8427e"
    },
    "SARUS_SYSTEM_USER": {
      "description": "Системный пользователь Техплатформы «САРУС»",
      "default": "$System"
    }
  }
}
